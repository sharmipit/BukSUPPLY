# ==============================
# BukSUPPLY - Environment Config
# ==============================
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to git.

# --- MongoDB Atlas ---
# URI structure configured for buksupply-cluster:
MONGODB_URI=mongodb+srv://<username>:<password>@buksupply-cluster.lojr1ip.mongodb.net/buksupply_dev?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@buksupply-cluster.lojr1ip.mongodb.net/buksupply_dev?retryWrites=true&w=majority

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Auth / JWT ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# --- Forgot Password (reset token) ---
RESET_TOKEN_EXPIRES_MINUTES=15

# --- Email (for sending forgot-password links, e.g. via Nodemailer + Gmail/SendGrid) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="BukSUPPLY Support <no-reply@buksupply.com>"

# --- Frontend URL (used to build the password reset link) ---
CLIENT_URL=http://localhost:3000

# --- GOOGLE CLIENT_ID and GOOGLE_CLIENT_SECRET (for Google OAuth) ---

GOOGLE_CLIENT_ID=119378619205-32j7sol7rdlks9jmda04geetnlng6ovu.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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