# Copy this file and rename it to .env

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/buksupply
CLIENT_ORIGIN=http://127.0.0.1:5500

JWT_SECRET=paste-your-random-string-here
JWT_EXPIRES_IN=1d

# Leave SMTP_HOST empty for now: reset codes will print in your terminal
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BukSUPPLY <no-reply@buksu.edu.ph>"

# Only used once, by: npm run seed:admin
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
ADMIN_EMAIL=admin@buksu.edu.ph
ADMIN_CONTACT=09123456789
ADMIN_PASSWORD=ChangeMe123