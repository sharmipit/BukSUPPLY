# --- MongoDB Atlas ---
MONGO_URI=mongodb+srv://<username>:<password>@buksupply-cluster.lojr1ip.mongodb.net/buksupply_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@buksupply-cluster.lojr1ip.mongodb.net/buksupply_dev?retryWrites=true&w=majority

# --- Server ---
PORT=5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --- Auth / JWT ---
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# --- Forgot Password ---
RESET_TOKEN_EXPIRES_MINUTES=15

# --- Email ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="BukSUPPLY Support <no-reply@buksupply.com>"

# --- Frontend URL ---
CLIENT_URL=http://localhost:5173

# --- GOOGLE CLIENT_ID and GOOGLE_CLIENT_SECRET ---

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret